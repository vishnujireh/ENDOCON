# ─────────────────────────────────────────────────────────────────────────────
# ENDOCON 2027 API – environment variables. Copy to .env and fill in.
# NEVER commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development            # development | test | production
PORT=4000
LOG_LEVEL=info
TRUST_PROXY=1                   # number of reverse proxies in front (nginx/ALB) – needed for correct client IPs

# Public URLs Live
APP_URL=http://localhost:4000           # this API
FRONTEND_URL=http://localhost:3000      # the SPA (used in email links and as the allowed CORS/CSRF origin)
CORS_ORIGINS=                           # extra allowed origins, comma-separated (e.g. http://127.0.0.1:3000)

# Database – MySQL 8 (or MariaDB 10.6+), utf8mb4
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=endocon
DB_PASSWORD=
DB_NAME=endocon
DB_POOL_MAX=10

# Sessions (httpOnly cookie, stored hashed in the DB)
SESSION_COOKIE_NAME=endocon_sid
SESSION_TTL_HOURS=168                   # idle timeout (sliding)
SESSION_ABSOLUTE_TTL_HOURS=720          # hard limit
COOKIE_SECURE=                          # defaults to true in production
COOKIE_DOMAIN=
PASSWORD_RESET_TTL_MINUTES=30

# Event
EVENT_TIMEZONE=Asia/Kolkata
# Categories, workshops, accommodation, prices, pricing-period dates, GST % and the USD→INR rate
# live in ONE static file shared with the frontend: ../shared/catalogue.json (no DB tables).
# CATALOGUE_FILE=../shared/catalogue.json   # optional override
ORDER_NUMBER_PREFIX=ENDO                # ENDO-0001
INVOICE_NUMBER_PREFIX=ENDO              # ENDO/2026-27/00001
ABSTRACT_NUMBER_PREFIX=ENDO27-ABS       # ENDO27-ABS-0001
ABSTRACT_SUBMISSION_OPENS=2026-09-01T00:00:00+05:30
ABSTRACT_SUBMISSION_CLOSES=2027-02-28T23:59:59+05:30   # placeholder – confirm with the Scientific Committee
# PRICING_NOW_OVERRIDE=2027-01-20T10:00:00+05:30       # QA only (refused in production)

# Payments – Razorpay (https://dashboard.razorpay.com → Settings → API Keys / Webhooks)
PAYMENT_GATEWAY=razorpay                # razorpay | fake (fake = local testing only, refused in production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_RECONCILE_INTERVAL_SECONDS=300
PAYMENT_STALE_AFTER_MINUTES=10
PAYMENT_EXPIRE_AFTER_HOURS=24

# Email
# Brevo (same setup as LTSICON). Email is sent through Brevo as soon as BREVO_API_KEY is set.
BREVO_API_KEY=your-brevo-api-key        # Brevo → SMTP & API → API Keys (starts with xkeysib-)
BREVO_SENDER_EMAIL=jirehhelpdesk@gmail.com   # must be a verified sender in Brevo → Senders & Domains
BREVO_SENDER_NAME=ENDOCON 2027
# EMAIL_TRANSPORT=brevo                 # optional override: brevo | smtp | console (console = log only)
EMAIL_REPLY_TO=endocon2027@gmail.com
ADMIN_NOTIFICATION_EMAILS=endocon2027@gmail.com   # comma-separated; receives payment notifications
EMAIL_WORKER_INTERVAL_SECONDS=10

# Admin accounts – `npm run seed-admins` (server: `npm run seed-admins:prod`) creates these
# accounts, or turns existing ones into admins, with ADMIN_DEFAULT_PASSWORD. Change the password
# and re-run the seed to rotate it (open admin sessions are ended). Sign in at /admin.
ADMIN_EMAILS=endocon2027@gmail.com      # comma-separated
ADMIN_DEFAULT_PASSWORD=change-me-Strong1  # min 8 characters, letters + numbers

# Organisation / invoice (replace when the official invoice format is provided)
ORG_NAME="ENDOCON 2027 Organising Committee"
ORG_ADDRESS="Kolkata, West Bengal, India"
ORG_GSTIN=
ORG_PAN=
ORG_STATE_CODE=19
ORG_SAC_CODE=998596
SUPPORT_PHONE=
SUPPORT_EMAIL=endocon2027@gmail.com

# File storage (abstract uploads, invoice PDFs) – outside any public web root
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
UPLOAD_MAX_MB=20                        # documents & images (PDF, Word, JPG, PNG)
UPLOAD_MAX_VIDEO_MB=500                 # videos (MP4, MOV, WebM) – nginx client_max_body_size must allow this

# Background jobs (email outbox + payment reconciliation) run inside the API process
RUN_JOBS=true

# Development seed only
# DEV_ADMIN_EMAIL=admin@endocon.local
# DEV_ADMIN_PASSWORD=ChangeMe@2027

# ---- Abstract reviewers (judges) – OTP login ----
REVIEWER_OTP_TTL_MINUTES=10             # a code is valid for this long, and only once
REVIEWER_OTP_MAX_ATTEMPTS=5             # wrong entries before the code is cancelled
REVIEWER_OTP_RESEND_SECONDS=60          # minimum wait before another code can be sent
REVIEWER_SESSION_TTL_HOURS=12
